# TeleClaude minimal zsh env. Read by every zsh invocation (interactive,
# login, non-interactive `zsh -c`). Ensures ~/.teleclaude/bin is first in
# PATH so the agent-session git wrapper wins for every subshell an agent
# CLI spawns, regardless of parent state or platform-specific path_helper.
case ":$PATH:" in
  ":$HOME/.teleclaude/bin:"*) ;;
  *) export PATH="$HOME/.teleclaude/bin:$PATH" ;;
esac
