# TeleClaude minimal zsh env. Read by every zsh invocation (interactive,
# login, non-interactive `zsh -c`). Implements the agent-shell PATH-pin
# and terminal-hint contract; the body below is kept byte-identical across
# zshenv, bashenv, and profile. See project/spec/agent-shell-path.
#
# Honors $TELECLAUDE_HOME (matches teleclaude.paths.TELECLAUDE_HOME),
# falling back to ~/.teleclaude when the override is unset.
TC_HOME="${TELECLAUDE_HOME:-$HOME/.teleclaude}"

# Guarantee the platform's published tool dirs are on PATH regardless of the
# launching context: ~/.local/bin (graphify, telec), ~/.cargo/bin (rust), and
# ~/.npm-global/bin (npm-global installs: node, npm, dsh).
# Position among these is non-critical, so add only when missing.
for _tc_dir in "$HOME/.npm-global/bin" "$HOME/.cargo/bin" "$HOME/.local/bin"; do
  [ -d "$_tc_dir" ] || continue
  case ":$PATH:" in
    *":$_tc_dir:"*) ;;
    *) PATH="$_tc_dir:$PATH" ;;
  esac
done
# The agent-session git wrapper MUST win: $TC_HOME/bin first. Front-anchored
# guard so a non-first occurrence is moved to the front.
case ":$PATH:" in
  ":$TC_HOME/bin:"*) ;;
  *) PATH="$TC_HOME/bin:$PATH" ;;
esac
unset _tc_dir
export PATH

# Terminal hints for agent TUIs. Agent panes are tmux panes; advertise
# truecolor and the tmux-truecolor hatch so TUIs that self-clamp under
# $TMUX (@deepseek-harness-tui/dsh-tui, Claude Code) keep full color —
# the pane attach sets Tc/RGB terminal-overrides, so truecolor passes
# through and the clamp must not fire.
export COLORTERM=truecolor
export CLAUDE_CODE_TMUX_TRUECOLOR=1
