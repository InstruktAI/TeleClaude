# TeleClaude minimal interactive zsh rc. Loaded for interactive shells
# inside teleclaude-managed tmux sessions. Intentionally bare: no
# oh-my-zsh, no plugins, no completions. Predictable, fast startup.
TC_HOME="${TELECLAUDE_HOME:-$HOME/.teleclaude}"
[ -f "$TC_HOME/shell/.zshenv" ] && source "$TC_HOME/shell/.zshenv"
PS1='%n@%m:%~ %# '
