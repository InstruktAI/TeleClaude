#!/usr/bin/env bash
# Git wrapper for TeleClaude agent sessions.
# Blocks destructive git operations in agent sessions.
# Push-to-main protection is handled by the pre-push hook (.githooks/pre-push).
# Installed via `telec init` into ~/.teleclaude/bin/git.
#
# Permissions are derived from TELECLAUDE_SYSTEM_ROLE (set by the daemon from
# session_metadata.system_role). Roles: worker (default), orchestrator, integrator, system.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

_real_git() {
    IFS=: read -ra path_parts <<< "$PATH"
    for dir in "${path_parts[@]}"; do
        [ "$dir" = "$SCRIPT_DIR" ] && continue
        if [ -x "$dir/git" ]; then
            "$dir/git" "$@"
            return $?
        fi
    done
    echo "ERROR: real git binary not found in PATH" >&2
    exit 1
}

# Find the actual git subcommand by skipping global flags.
_subcmd=""
_skip_next=0
for _arg in "$@"; do
    if [ "$_skip_next" -eq 1 ]; then
        _skip_next=0
        continue
    fi
    case "$_arg" in
        -C|-c|--git-dir|--work-tree|--namespace)
            _skip_next=1
            ;;
        --git-dir=*|--work-tree=*|--namespace=*|-c*)
            ;;
        --bare|--no-pager|--paginate|--no-replace-objects|--literal-pathspecs|--glob-pathspecs|--no-optional-locks)
            ;;
        -*)
            ;;
        *)
            _subcmd="$_arg"
            break
            ;;
    esac
done

_role="${TELECLAUDE_SYSTEM_ROLE:-worker}"

# Blocked subcommands (version-control-safety policy)
case "$_subcmd" in
    stash)
        if [ "$_role" != "integrator" ]; then
            echo "ERROR: 'git stash' is prohibited in agent sessions. Use commits instead." >&2
            exit 1
        fi
        ;;
    checkout)
        # File-scoped checkout (contains '--' separator) is allowed for integrator and system roles.
        # Branch/bare checkout is always blocked.
        _has_separator=0
        for _carg in "$@"; do
            [ "$_carg" = "--" ] && _has_separator=1
        done
        if [ "$_has_separator" -eq 1 ] && { [ "$_role" = "integrator" ] || [ "$_role" = "system" ]; }; then
            : # allowed — file-scoped checkout
        else
            echo "ERROR: 'git checkout' is prohibited in agent sessions. Use 'git switch' for branches or commits for file changes." >&2
            exit 1
        fi
        ;;
    restore)
        echo "ERROR: 'git restore' is prohibited in agent sessions. Commit or discard intentionally." >&2
        exit 1
        ;;
    clean)
        echo "ERROR: 'git clean' is prohibited in agent sessions. Do not delete untracked files." >&2
        exit 1
        ;;
    revert)
        _has_confirmed=0
        for _rarg in "$@"; do
            [ "$_rarg" = "--confirmed" ] && _has_confirmed=1
        done
        if [ "$_has_confirmed" -eq 0 ]; then
            cat >&2 <<'MSG'
WARNING: 'git revert' blocked — inspection required.

Commits in multi-agent environments often contain changes from multiple workers.
A blind revert destroys other agents' work.

Before reverting:
  1. Run: git show --stat <commit>
  2. Verify EVERY file in the commit belongs to the scope you intend to undo.
  3. Rerun with: git revert --confirmed <commit>
MSG
            exit 1
        fi
        # Strip --confirmed before passing to real git
        _revert_args=()
        for _rarg in "$@"; do
            [ "$_rarg" = "--confirmed" ] && continue
            _revert_args+=("$_rarg")
        done
        _real_git "${_revert_args[@]}"
        exit $?
        ;;
esac

# Block reset variants that move HEAD (version-control-safety policy)
if [ "$_subcmd" = "reset" ]; then
    _has_separator=0
    _non_flag_args=0
    
    _is_subcmd=0
    for _arg in "$@"; do
        if [ "$_is_subcmd" -eq 0 ]; then
            [ "$_arg" = "reset" ] && _is_subcmd=1
            continue
        fi
        
        case "$_arg" in
            --hard|--merge|--keep)
                echo "ERROR: 'git reset $_arg' is prohibited in agent sessions. Do not discard commits." >&2
                exit 1
                ;;
            --)
                _has_separator=1
                ;;
            -*)
                ;;
            *)
                _non_flag_args=$((_non_flag_args + 1))
                ;;
        esac
    done

    # Pathspec reset (allowed): git reset [<tree-ish>] [--] <pathspec>...
    # Commit reset (prohibited): git reset [<mode>] [<commit>]
    
    # We allow pathspec resets if they are unambiguous:
    # 1. Contain '--' separator
    # 2. Contain at least 2 non-flag arguments (likely <tree-ish> <pathspec>)
    if [ "$_has_separator" -eq 1 ] && [ "$_non_flag_args" -ge 1 ]; then
        : # allowed — pathspec reset (separator + at least one pathspec arg)
    elif [ "$_non_flag_args" -ge 2 ]; then
        : # allowed — likely 'git reset <tree-ish> <pathspec>...'
    else
        # 0 or 1 non-flag args without '--' is either bare reset or ambiguous 'git reset <commit|path>'.
        # We block these to prevent accidental HEAD movement or full index reset.
        cat >&2 <<'MSG'
ERROR: 'git reset' without explicit pathspecs is prohibited.

To unstage specific files, use:
  git reset HEAD <path>
  git reset -- <path>

Bare 'git reset' or 'git reset <commit>' are blocked because they move HEAD
or discard the entire staging area, which violates safety policy.
MSG
        exit 1
    fi
fi

# Block commits on main (agents must use review pipeline)
if [ "$_subcmd" = "commit" ]; then
    _current_branch="$(_real_git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ "$_current_branch" = "main" ] && [ "$_role" != "system" ]; then
        cat >&2 <<'MSG'
ERROR: Commits on main are blocked for agent sessions.
Your changes must go through the review pipeline.

Run:  telec todo from-main --slug <meaningful-name>

This creates a worktree with your changes, scaffolds a todo,
and prepares everything for the review cycle.

Then run:  telec todo work <slug>
MSG
        exit 1
    fi
fi

# Block pushes from main (only system role may push)
if [ "$_subcmd" = "push" ]; then
    _current_branch="$(_real_git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ "$_current_branch" = "main" ] && [ "$_role" != "system" ]; then
        cat >&2 <<'MSG'
ERROR: Push from main is blocked for agent sessions.
Only the system role may push to remote.

If you have uncommitted work, run: telec todo from-main --slug <meaningful-name>
Then run:  telec todo work <slug>
MSG
        exit 1
    fi
fi

_real_git "$@"