#!/usr/bin/env bash
# Git wrapper for TeleClaude sessions.
#
# The declaration cache hit is pure bash and fork-free; a miss asks this
# checkout's Python runtime to resolve and publish the declaration view.
# The common wrapper path must stay fast because prompts and hubs call git often.
#
# Permission model for agent sessions (see docs/local/design/code-commit.md
# for the full operations matrix):
#   DESTRUCTIVE  — blocked for all agent roles, no override
#                  (stash, merge/rebase/pull --autostash, clean, switch,
#                   reset --hard/--merge/--keep,
#                   branch-switching checkout)
#   PROTECTED    — integrator only (push on main)
#                  REPLAY  (cherry-pick/rebase/merge on main) — integrator role
#                          or TELECLAUDE_OVERRIDE_APPROVED=1
#   CONFIRMED    — friction-gated (require --confirmed after reading the
#                  inspection checklist):
#                    revert (any context — multi-agent commits)
#                    checkout <ref> -- <path>  inside integration worktree OR active merge
#                    checkout -- <path>         inside integration worktree OR active merge
#                    restore <path>             inside integration worktree OR active merge
#                    restore --source <ref>     inside integration worktree OR active merge
#   PATHSPEC-OK  — pathspec-scoped variants pass through:
#                    reset HEAD <path> / reset -- <path>
#                    restore --staged <path>
#                    checkout -- <path> (outside integration / merge)
#   RESTRICTED   — orchestrator cannot commit on any branch
#
# Commit-producing subcmds (commit, cherry-pick, rebase, merge) are gated:
#   commit (any branch)              → use 'telec repo commit'.
#   cherry-pick/rebase/merge on main → integrator role bypass, otherwise
#                                       set TELECLAUDE_OVERRIDE_APPROVED=1
#   cherry-pick/rebase/merge on other branches → pass through
#
# Trusted external tools may set TELECLAUDE_TRUSTED_TOOL=1 to step aside the
# wrapper entirely (all gates). Logged as event=bypass reason=trusted_tool.
#
# The lean caller-role entrypoint runs only on the replay-on-main and push-on-main gates.
#
# Behavior by context:
#   Outside tmux ($TMUX unset): pass through, no restrictions.
#   Inside tmux: apply code and commit protections from the repository declaration.
#   Resolve caller role only for commit-producing replay on main and push from main.
#   TELECLAUDE_SYSTEM_ROLE override is honored only for a person-rooted session.
#
# Installed via `make install` as a symlink at ~/.teleclaude/bin/git, beside
# the teleclaude-capabilities.sh declaration reader it sources.
#
# Capability ownership: code gates worktree and replay discipline; code or
# docs gates sealed staging and commit interception. The runtime resolves the
# repository's own teleclaude.yml; data-only and agents-only repositories pass
# through to ordinary git.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/instrukt-ai/teleclaude/git-wrapper.log"
mkdir -p "$(dirname "$WRAPPER_LOG")" 2>/dev/null || true
_role=""

# Use gdate when available so timestamps match the daemon log format
# (ms-precision ISO-8601 Z). Fall back to BSD date (s-precision).
if command -v gdate >/dev/null 2>&1; then
    _ts_cmd() { gdate -u +%Y-%m-%dT%H:%M:%S.%3NZ; }
else
    _ts_cmd() { date -u +%Y-%m-%dT%H:%M:%SZ; }
fi

# Write-time level gate honoring TELECLAUDE_LOG_LEVEL. Rank ladder matches
# instrukt_ai_logging/logging.py: TRACE=5 DEBUG=10 INFO=20 WARNING=30 ERROR=40.
# Pure function calls — no $(...) subshell fork, no `declare -A` (bash 3.2 on
# macOS has no associative arrays) — to preserve the <5ms overhead budget.
_log_rank() {
    case "$1" in
        TRACE) _log_rank_result=5 ;;
        DEBUG) _log_rank_result=10 ;;
        WARNING) _log_rank_result=30 ;;
        ERROR) _log_rank_result=40 ;;
        *) _log_rank_result=20 ;;  # INFO and default
    esac
}

_log_rank "${TELECLAUDE_LOG_LEVEL:-INFO}"
_LOG_THRESHOLD_RANK="$_log_rank_result"

_level_enabled() {
    _log_rank "$1"
    [ "$_log_rank_result" -ge "$_LOG_THRESHOLD_RANK" ]
}

_find_real_git_fast() {
    IFS=: read -ra path_parts <<< "$PATH"
    for dir in "${path_parts[@]}"; do
        [ "$dir" = "$SCRIPT_DIR" ] && continue
        [ -z "$dir" ] && continue
        if [ -x "$dir/git" ]; then
            echo "$dir/git"
            return 0
        fi
    done
    echo "ERROR: real git binary not found in PATH" >&2
    exit 1
}

# ── Fast exit: not in tmux → no restrictions ─────────────────────────────────
if [ -z "${TMUX:-}" ]; then
    exec "$(_find_real_git_fast)" "$@"
fi

# Declare _real_git_bin once for the session
_real_git_bin="$(_find_real_git_fast)"

# Trusted external tool bypass — step aside entirely. The caller owns its
# own commit/push/rebase discipline. Logged so the audit trail captures it.
if [ "${TELECLAUDE_TRUSTED_TOOL:-}" = "1" ]; then
    if _level_enabled DEBUG; then
        { echo "$(_ts_cmd) level=DEBUG logger=git-wrapper event=bypass reason=trusted_tool args=$* cwd=$(pwd)" >> "$WRAPPER_LOG"; } 2>/dev/null || true
    fi
    exec "$_real_git_bin" "$@"
fi

_real_git() {
    # Disable config-driven auto-stash for every git invocation through the wrapper.
    local _count="${GIT_CONFIG_COUNT:-0}"
    export GIT_CONFIG_COUNT=$((_count + 3))
    export "GIT_CONFIG_KEY_${_count}=rebase.autoStash"
    export "GIT_CONFIG_VALUE_${_count}=false"
    export "GIT_CONFIG_KEY_$((_count + 1))=merge.autoStash"
    export "GIT_CONFIG_VALUE_$((_count + 1))=false"
    export "GIT_CONFIG_KEY_$((_count + 2))=pull.autoStash"
    export "GIT_CONFIG_VALUE_$((_count + 2))=false"

    # Git's exit status and output belong to the caller, which alone knows
    # whether a non-zero exit answers its question or reports a failure.
    "$_real_git_bin" "$@"
}

# Refusal logger. The wrapper's refusals are the only git outcomes it can
# classify, so each refusal path records one event=blocked line:
#   DEBUG — the wrapper refused an operation the session attempted, as designed.
#   ERROR — the wrapper could not establish what to enforce (pass ERROR).
# The session id names the transcript that shows why the operation was attempted.
_log_block() {
    local _reason="$1"
    local _level="${2:-DEBUG}"
    local _session_id="" _identity_doc=""
    if _level_enabled "$_level"; then
        if [ -r "${TMPDIR:-}/teleclaude_identity.json" ]; then
            IFS= read -r _identity_doc < "$TMPDIR/teleclaude_identity.json" || true
            if [[ "$_identity_doc" =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
                _session_id="${BASH_REMATCH[1]}"
            fi
        fi
        { echo "$(_ts_cmd) level=$_level logger=git-wrapper event=blocked reason=$_reason subcmd=${_subcmd:-} role=${_role:-} session_id=$_session_id cwd=$PWD" >> "$WRAPPER_LOG"; } 2>/dev/null || true
    fi
}

_resolve_caller_role() {
    local _source="$0" _dir _target _checkout _output _line
    while [ -L "$_source" ]; do
        _dir="$(cd "$(dirname "$_source")" && pwd)"
        _target="$(readlink "$_source")"
        if [[ "$_target" == /* ]]; then
            _source="$_target"
        else
            _source="$_dir/$_target"
        fi
    done
    _checkout="$(cd "$(dirname "$_source")/../../.." && pwd)" || return 1
    if ! _output="$(UV_NO_SYNC=1 uv run --directory "$_checkout" --quiet python -m teleclaude.cli.caller_role)"; then
        return 1
    fi

    _agent_role=""
    _person_role=""
    while IFS= read -r _line || [ -n "$_line" ]; do
        case "$_line" in
            role=*) _agent_role="${_line#role=}" ;;
            person_role=*) _person_role="${_line#person_role=}" ;;
        esac
    done <<< "$_output"
    if [ -n "$_person_role" ] && [ -n "${TELECLAUDE_SYSTEM_ROLE:-}" ]; then
        _agent_role="$TELECLAUDE_SYSTEM_ROLE"
    fi
    if [ -n "$_person_role" ] && [ -z "$_agent_role" ]; then
        _role="worker"
    else
        _role="$_agent_role"
    fi
}

# Shared knowledge: which git global options consume the following argument
# and which are fully self-contained. Both the subcommand-detection parser
# below (which needs -C's value as a directory) and the local-`main` ref
# scanner further down (which must not mistake a global option's value for a
# ref) consult this single definition, so the two lists cannot diverge.
# Sets _global_opt_result to:
#   capture-C — the token is -C; the caller consumes the next argument as the
#               effective directory.
#   skip      — the token is -c/--git-dir/--work-tree/--namespace; the caller
#               consumes the next argument with no other action.
#   self      — the token is a =-joined or attached-form global option; no
#               following argument is consumed.
#   (empty)   — the token is not one of these global options.
_classify_global_opt() {
    case "$1" in
        -C)
            _global_opt_result="capture-C"
            ;;
        -c|--config-env|--git-dir|--work-tree|--namespace)
            _global_opt_result="skip"
            ;;
        --config-env=*|--git-dir=*|--work-tree=*|--namespace=*|-c*)
            _global_opt_result="self"
            ;;
        *)
            _global_opt_result=""
            ;;
    esac
}

# ── Parse git subcommand and -C args ─────────────────────────────────────────
_subcmd=""
_skip_next=0
_capture_C=0
_dir_args=()
for _arg in "$@"; do
    if [ "$_capture_C" -eq 1 ]; then
        _dir_args+=("-C" "$_arg")
        _capture_C=0
        _skip_next=0
        continue
    fi
    if [ "$_skip_next" -eq 1 ]; then
        _skip_next=0
        continue
    fi
    _classify_global_opt "$_arg"
    if [ "$_global_opt_result" = "capture-C" ]; then
        _capture_C=1
        _skip_next=1
        continue
    elif [ "$_global_opt_result" = "skip" ]; then
        _skip_next=1
        continue
    elif [ "$_global_opt_result" = "self" ]; then
        continue
    fi
    case "$_arg" in
        --bare|--no-pager|--paginate|--no-replace-objects|--literal-pathspecs|--glob-pathspecs|--no-optional-locks)
            ;;
        -*)
            ;;
        *)
            _subcmd="$_arg"
            break
            ;;
    esac
done

# Git uses numeric indexes for GIT_CONFIG_KEY/VALUE pairs, while Bash treats an
# unvalidated count as arithmetic. Reject non-decimal or unbounded counts before
# the repository lookup or the forced autoStash values can use them.
_inherited_config_count="${GIT_CONFIG_COUNT:-0}"
if [[ ! "$_inherited_config_count" =~ ^(0|[1-9][0-9]{0,2})$ ]]; then
    _log_block invalid_git_config_count
    echo "ERROR: GIT_CONFIG_COUNT must be a decimal count from 0 to 999 in agent sessions." >&2
    exit 1
fi
export GIT_CONFIG_COUNT="$_inherited_config_count"

# ── Not a telec-registered project → transparent passthrough ─────────────────
# teleclaude.yml sits at the repo root next to .git. When the working tree this
# command operates on carries no teleclaude.yml, the repo is not telec-managed:
# the wrapper enforces nothing and execs the real git binary, exactly as it does
# outside tmux. Resolving the toplevel through git honors -C/--work-tree, so the
# guards cannot be sidestepped on a registered repo from an unregistered cwd.
_toplevel="$("$_real_git_bin" ${_dir_args[@]+"${_dir_args[@]}"} rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$_toplevel" ] || [ ! -f "$_toplevel/teleclaude.yml" ]; then
    exec "$_real_git_bin" "$@"
fi

# ── Resolve capabilities from the runtime declaration view ─────────────────
# teleclaude.yml is the source of the declaration; the runtime supplies its
# current-schema answer and the dependency stamps checked by the cache hit.
# A declaration the reader cannot resolve refuses the git invocation.
# shellcheck source=teleclaude/install/wrappers/teleclaude-capabilities.sh
source "$SCRIPT_DIR/teleclaude-capabilities.sh"
if ! teleclaude_read_declaration "$_toplevel/teleclaude.yml"; then
    _log_block declaration_unreadable ERROR
    echo "ERROR: $TC_DECL_ERROR" >&2
    echo "       Repair the declaration before git can proceed in this session." >&2
    exit 1
fi
_code_enabled=$TC_DECL_CODE
_docs_enabled=$TC_DECL_DOCS
case "$TC_DECL_KIND" in
    global | person) _sealed_invocation_context=1 ;;
    *) _sealed_invocation_context=0 ;;
esac
_commit_enabled=0
if [ "$_code_enabled" -eq 1 ] || [ "$_docs_enabled" -eq 1 ]; then
    _commit_enabled=1
fi

# Agents-only and data projects own no git-wrapper behavior. Their git surface
# is ordinary git even inside a TeleClaude session.
if [ "$_code_enabled" -eq 0 ] && [ "$_commit_enabled" -eq 0 ] && [ "$_sealed_invocation_context" -eq 0 ]; then
    exec "$_real_git_bin" "$@"
fi

# Git's explicit flag overrides the autoStash config values disabled above.
# Scan the full argument vector: an unrecognized global option may make the
# subcommand detector mistake its value for the subcommand. Git accepts
# unambiguous long-option prefixes: merge and pull accept --au, while rebase
# accepts --autost. Do not catch --auto on unrelated commands such as git gc.
if [ "$_code_enabled" -eq 1 ]; then
    _has_merge_or_pull=0
    for _arg in "$@"; do
        case "$_arg" in
            merge|pull) _has_merge_or_pull=1 ;;
        esac
    done
    for _arg in "$@"; do
        _autostash_option=0
        case "$_arg" in
            --autost*) _autostash_option=1 ;;
            --au*)
                [ "$_has_merge_or_pull" -eq 1 ] && _autostash_option=1
                ;;
        esac
        if [ "$_autostash_option" -eq 1 ]; then
            _log_block autostash_explicit
            echo "ERROR: An autostash option is prohibited in agent sessions." >&2
            echo "       Resolve or commit worktree changes before replaying history." >&2
            exit 1
        fi
    done
fi

# Command-line config can override the false autoStash values injected by
# _real_git. Refuse direct autoStash keys and per-command includes before Git
# reads them; the argument scan below retains the alias-redefinition guard.
_prev_arg=""
for _arg in "$@"; do
    _config_override=""
    case "$_prev_arg" in
        -c|--config-env) _config_override="$_arg" ;;
    esac
    case "$_arg" in
        -c?*) _config_override="${_arg#-c}" ;;
        --config-env=*) _config_override="${_arg#--config-env=}" ;;
    esac
    if [ "$_code_enabled" -eq 1 ]; then
        case "$_config_override" in
            *.[Aa][Uu][Tt][Oo][Ss][Tt][Aa][Ss][Hh]|*.[Aa][Uu][Tt][Oo][Ss][Tt][Aa][Ss][Hh]=*|*[Ii][Nn][Cc][Ll][Uu][Dd][Ee]*)
                _log_block autostash_config_override
                echo "ERROR: Per-command autoStash or config includes are prohibited in agent sessions." >&2
                echo "       Resolve or commit worktree changes before replaying history." >&2
                exit 1
                ;;
        esac
    fi
    case "$_prev_arg:$_arg" in
        -c:alias.*)
            _subcmd="config"
            _log_block alias_redefinition
            echo "ERROR: 'git -c alias.<name>=…' is prohibited in agent sessions." >&2
            echo "       Agents must not redefine git subcommands at invocation time." >&2
            exit 1
            ;;
    esac
    case "$_arg" in
        -calias.*)
            _subcmd="config"
            _log_block alias_redefinition
            echo "ERROR: 'git -calias.<name>=…' is prohibited in agent sessions." >&2
            echo "       Agents must not redefine git subcommands at invocation time." >&2
            exit 1
            ;;
    esac
    _prev_arg="$_arg"
done
if [ "$_code_enabled" -eq 1 ]; then
    case "${GIT_CONFIG_PARAMETERS:-}" in
        *.[Aa][Uu][Tt][Oo][Ss][Tt][Aa][Ss][Hh]*|*[Ii][Nn][Cc][Ll][Uu][Dd][Ee]*)
            _log_block autostash_config_override
            echo "ERROR: Inherited autoStash or config includes are prohibited in agent sessions." >&2
            echo "       Resolve or commit worktree changes before replaying history." >&2
            exit 1
            ;;
    esac
fi

# ── Detect effective working tree: integration vs. slug vs. neither ─────────
# Hoisted ahead of every code-gated subcommand handler (destructive ops,
# reset, revert, checkout/restore --confirmed, replay, push) so no early-exit
# path below can reach `_real_git` without first passing the local-`main`
# ref gate that follows. Resolve from any `-C <dir>` args first so
# `git -C trees/<slug> ...` invoked from outside cannot bypass either gate.
# Fall back to $PWD only if git can't resolve a tree. Reuse the toplevel
# already resolved by the registration gate above (we only reach here when it
# was non-empty and carried a teleclaude.yml).
_effective_wt="${_toplevel:-}"
[ -z "$_effective_wt" ] && _effective_wt="$PWD"
case "$_effective_wt" in
    */trees/_integration|*/trees/_integration/*)
        _in_integration_wt=1
        _in_slug_wt=0
        ;;
    */trees/*)
        _in_integration_wt=0
        _in_slug_wt=1
        ;;
    *)
        _in_integration_wt=0
        _in_slug_wt=0
        ;;
esac

# A single token's exact-string check against the bare local-`main` forms.
# Kept apart from the scan below so the two-/three-dot range check can apply
# it to each endpoint without duplicating the form list.
_is_local_main_form() {
    case "$1" in
        main|heads/main|refs/heads/main|^main)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Ref-position argument scan: does any argument before a literal `--` name
# local `main`? Declared once so the token forms live in one place and the
# diagnostic can echo back what matched. Consults the same
# `_classify_global_opt` the subcommand parser above uses, so a global
# option's value is never mistaken for a ref by one scanner and not the other.
_names_local_main() {
    local _arg
    local _skip_next=0
    local _capture_C=0
    local _val
    local _left
    local _right
    for _arg in "$@"; do
        if [ "$_capture_C" -eq 1 ]; then
            _capture_C=0
            _skip_next=0
            continue
        fi
        if [ "$_skip_next" -eq 1 ]; then
            _skip_next=0
            continue
        fi
        if [ "$_arg" = "--" ]; then
            return 1
        fi
        _classify_global_opt "$_arg"
        if [ "$_global_opt_result" = "capture-C" ]; then
            _capture_C=1
            _skip_next=1
            continue
        elif [ "$_global_opt_result" = "skip" ]; then
            _skip_next=1
            continue
        elif [ "$_global_opt_result" = "self" ]; then
            continue
        fi
        case "$_arg" in
            --source=*)
                _val="${_arg#--source=}"
                if _is_local_main_form "$_val"; then
                    _names_local_main_match="$_arg"
                    return 0
                fi
                continue
                ;;
            --onto=*)
                _val="${_arg#--onto=}"
                if _is_local_main_form "$_val"; then
                    _names_local_main_match="$_arg"
                    return 0
                fi
                continue
                ;;
        esac
        if _is_local_main_form "$_arg"; then
            _names_local_main_match="$_arg"
            return 0
        fi
        case "$_arg" in
            *..*)
                _left="${_arg%%..*}"
                _right="${_arg##*..}"
                if _is_local_main_form "$_left" || _is_local_main_form "$_right"; then
                    _names_local_main_match="$_arg"
                    return 0
                fi
                ;;
        esac
    done
    return 1
}

# ── Slug worktree: origin/main is the only baseline ──────────────────────────
# A slug worktree (trees/<slug>, never trees/_integration) never has a
# legitimate reason to name local main, read-only inspection included. The
# replay gate below keys on the branch stood on, not the ref named, so a
# manual `git merge main` from inside a slug worktree passes it silently and
# can carry unpushed local-main ancestry into a candidate's branch — the gap
# this gate closes. No --confirmed form, no override variable: placed ahead
# of every code-gated subcommand handler (including their own --confirmed
# early exits) so nothing below can reach git without passing this scan
# first. A pathspec after `--` is never inspected.
#
# `fetch` is exempt from the scan itself, not from the invariant: every
# positional argument after the remote name is a refspec whose source side
# resolves against that named remote, never against a local ref, so a bare
# `main` in `git fetch origin main` (the sanctioned pre-dispatch/pre-review
# sync's first half) already names origin's main, not local main.
if [ "$_code_enabled" -eq 1 ] && [ "$_in_slug_wt" -eq 1 ] && [ "$_subcmd" != "fetch" ] && _names_local_main "$@"; then
    _log_block local_main_ref_in_slug_worktree
    cat >&2 <<MSG
ERROR: '$_names_local_main_match' names local main from inside a slug worktree.

A slug worktree's only baseline is origin/main. Local main can carry commits
from other sessions that have not reached origin/main yet; reading or
merging it here produces answers wrong relative to the baseline this branch
is squashed onto at integration.

Rerun against the baseline instead, e.g.:
  git $_subcmd ... origin/main ...

To pass "main" as a literal option value rather than a ref, use the =-joined
form (e.g. --grep=main) instead of a separate argument.
MSG
    exit 1
fi

# ── CODE: destructive operations blocked for all roles, no override ─────────
if [ "$_code_enabled" -eq 1 ]; then
case "$_subcmd" in
    clean|switch)
        _log_block "destructive_${_subcmd}"
        echo "ERROR: 'git $_subcmd' is a destructive operation and is prohibited." >&2
        exit 1
        ;;
    revert)
        _has_confirmed=0
        for _rarg in "$@"; do
            [ "$_rarg" = "--confirmed" ] && _has_confirmed=1
        done
        if [ "$_has_confirmed" -eq 0 ]; then
            _log_block revert_no_confirmed
            cat >&2 <<'MSG'
WARNING: 'git revert' blocked — inspection required.

Commits in multi-agent environments often contain changes from multiple workers.
A blind revert destroys other agents' work.

Before reverting:
  1. Run: git show --stat <commit>
  2. Verify EVERY file in the commit belongs to the scope you intend to undo.
  3. Rerun with: git revert --confirmed <commit>
MSG
            exit 1
        fi
        _revert_args=()
        for _rarg in "$@"; do
            [ "$_rarg" = "--confirmed" ] && continue
            _revert_args+=("$_rarg")
        done
        _real_git "${_revert_args[@]}"
        exit $?
        ;;
esac
fi

# Destructive reset variants blocked; HEAD/pathspec unstage allowed;
# foreign tree-ish pathspec reset gated behind --confirmed.
if [ "$_code_enabled" -eq 1 ] && [ "$_subcmd" = "reset" ]; then
    _has_separator=0
    _has_reset_confirmed=0
    _non_flag_args=0
    _first_nonflag=""
    _is_subcmd=0
    for _arg in "$@"; do
        if [ "$_is_subcmd" -eq 0 ]; then
            [ "$_arg" = "reset" ] && _is_subcmd=1
            continue
        fi
        case "$_arg" in
            --hard|--merge|--keep)
                _log_block "destructive_reset_${_arg#--}"
                echo "ERROR: 'git reset $_arg' is prohibited in agent sessions. Do not discard commits." >&2
                exit 1
                ;;
            --confirmed)
                _has_reset_confirmed=1
                ;;
            --)
                _has_separator=1
                ;;
            -*)
                ;;
            *)
                [ -z "$_first_nonflag" ] && _first_nonflag="$_arg"
                _non_flag_args=$((_non_flag_args + 1))
                ;;
        esac
    done

    if [ "$_has_separator" -eq 1 ] && [ "$_non_flag_args" -ge 1 ]; then
        : # allowed — explicit pathspec reset (git reset -- <path>)
    elif [ "$_non_flag_args" -ge 2 ] && [ "$_first_nonflag" = "HEAD" ]; then
        : # allowed — HEAD-anchored unstage (git reset HEAD <path>)
    elif [ "$_non_flag_args" -ge 2 ]; then
        # Foreign tree-ish pathspec reset (git reset <ref> <path>): pulls
        # foreign content into the index and can update the working tree.
        # Require --confirmed (same friction as checkout <ref> -- <path>).
        if [ "$_has_reset_confirmed" = "0" ]; then
            _log_block reset_treeish_no_confirmed
            cat >&2 <<'MSG'
WARNING: 'git reset <tree-ish> <path>' — inspection required.

This rewrites the index entry from a foreign ref and (depending on mode)
can update the working tree. In a multi-agent environment, blind reset
from a non-HEAD ref can destroy intentional state.

Before proceeding:
  1. Run: git diff HEAD -- <file>   (see what local has)
  2. Run: git diff <ref> -- <file>  (see what the ref carries)
  3. Verify the local version has no unique work worth preserving.
  4. Rerun with: git reset --confirmed <ref> <path>...

To unstage from HEAD only, use:
  git reset HEAD <path>
  git reset -- <path>
MSG
            exit 1
        fi
        _reset_args=()
        for _arg in "$@"; do
            [ "$_arg" = "--confirmed" ] && continue
            _reset_args+=("$_arg")
        done
        _real_git "${_reset_args[@]}"
        exit $?
    else
        _log_block reset_no_pathspec
        cat >&2 <<'MSG'
ERROR: 'git reset' without explicit pathspecs is prohibited.

To unstage specific files, use:
  git reset HEAD <path>
  git reset -- <path>
MSG
        exit 1
    fi
fi

# ── DESTRUCTIVE: stash blocked unconditionally ───────────────────────────────
# Stash captures every dirty file in the worktree it runs in — there is no
# pathspec granularity that bounds it to "files this agent touched". In a
# multi-agent repo where the project root accumulates concurrent dirty state
# continuously, a single stash push lifts other agents' WIP; the pop later
# either reapplies cleanly (and the bookkeeping commit silently inherits
# foreign content) or conflicts (and the half-resolved state has no clean
# recovery). The integrator's documented recovery path when repo-root sync
# finds dirty files is to surface to the human, NOT to stash.
if [ "$_code_enabled" -eq 1 ] && [ "$_subcmd" = "stash" ]; then
    _log_block stash_unconditional
    cat >&2 <<'MSG'
ERROR: 'git stash' is prohibited in agent sessions, no override.

Stash captures every dirty file in the worktree — it cannot be bounded to
"only my changes". In a multi-agent repo this lifts other agents' WIP and
either silently reapplies it into a commit or leaves the worktree in a
half-resolved state with no clean recovery.

If you're the integrator and repo-root sync finds dirty files, halt and
surface to the human per the integration procedure. The procedure's
"if dirty files block the merge, STOP and ask the human" guidance is the
sanctioned recovery path; stash is not.
MSG
    exit 1
fi

if [ "$_code_enabled" -eq 1 ] && [ "$_subcmd" = "checkout" ]; then
    _has_separator=0
    for _carg in "$@"; do
        [ "$_carg" = "--" ] && _has_separator=1
    done
    if [ "$_has_separator" -eq 0 ]; then
        _log_block checkout_branch_switch
        echo "ERROR: 'git checkout' (branch switch) is a protected operation. Only file-scoped checkout (with --) is allowed." >&2
        exit 1
    fi
    # File-scoped checkout (-- present). Require --confirmed when (a) inside
    # the integration worktree, or (b) during active merge. Both contexts can
    # silently overwrite intentional working-tree state before the next
    # bookkeeping commit (integration) or conflict resolution (merge).
    _in_merge=0
    if [ -f "$(_real_git ${_dir_args[@]+"${_dir_args[@]}"} rev-parse --git-dir 2>/dev/null)/MERGE_HEAD" ]; then
        _in_merge=1
    fi
    if [ "$_in_integration_wt" = "1" ] || [ "$_in_merge" = "1" ]; then
        _has_co_confirmed=0
        for _carg in "$@"; do
            [ "$_carg" = "--confirmed" ] && _has_co_confirmed=1
        done
        if [ "$_has_co_confirmed" -eq 0 ]; then
            if [ "$_in_integration_wt" = "1" ]; then
                _log_block checkout_in_integration_no_confirmed
                cat >&2 <<'MSG'
WARNING: 'git checkout <ref> -- <files>' inside the integration worktree — inspection required.

The integration worktree's index and working tree feed DELIVERY_BOOKKEEPING,
which commits whatever is staged with no path filter. A blind checkout here
can land delivery-reverting content on origin/main.

Before proceeding:
  1. Run: git diff HEAD -- <file>   (see what the worktree has)
  2. Verify the working-tree version carries no resolution worth preserving.
  3. Rerun with: git checkout --confirmed <ref> -- <files>
MSG
            else
                _log_block checkout_in_merge_no_confirmed
                cat >&2 <<'MSG'
WARNING: 'git checkout <ref> -- <files>' during active merge — inspection required.

This overwrites local versions of conflicted files. In a multi-agent
environment, local main often has hotfixes not present on the remote.

Before proceeding:
  1. Run: git diff HEAD -- <file>   (see what local has)
  2. Run: git diff MERGE_HEAD -- <file>   (see what remote has)
  3. Verify the local version has no unique work worth preserving.
  4. Rerun with: git checkout --confirmed <ref> -- <files>
MSG
            fi
            exit 1
        fi
        _co_args=()
        for _carg in "$@"; do
            [ "$_carg" = "--confirmed" ] && continue
            _co_args+=("$_carg")
        done
        _real_git "${_co_args[@]}"
        exit $?
    fi
fi

# git restore: working-tree revert / unstage / cross-ref pull.
# Risk surface mirrors git checkout -- <path> / git reset -- <path> /
# git checkout <ref> -- <path>, so gating follows the same matrix.
if [ "$_code_enabled" -eq 1 ] && [ "$_subcmd" = "restore" ]; then
    _has_staged=0
    _has_worktree=0
    _has_source=0
    for _rarg in "$@"; do
        case "$_rarg" in
            --staged|-S|--staged=*) _has_staged=1 ;;
            --worktree|-W|--worktree=*) _has_worktree=1 ;;
            --source|-s|--source=*) _has_source=1 ;;
        esac
    done
    # Pure --staged (no --worktree, no --source): index-only effect, allowed.
    # --staged --worktree touches the working tree → gated like a plain restore.
    if [ "$_has_staged" = "1" ] && [ "$_has_worktree" = "0" ] && [ "$_has_source" = "0" ]; then
        : # allowed
    else
        # Working-tree restore (default) or --source <ref>: same friction surface as
        # checkout HEAD -- <path> / checkout <ref> -- <path>. Require --confirmed
        # inside integration worktree or during active merge.
        _in_merge=0
        if [ -f "$(_real_git ${_dir_args[@]+"${_dir_args[@]}"} rev-parse --git-dir 2>/dev/null)/MERGE_HEAD" ]; then
            _in_merge=1
        fi
        if [ "$_in_integration_wt" = "1" ] || [ "$_in_merge" = "1" ]; then
            _has_restore_confirmed=0
            for _rarg in "$@"; do
                [ "$_rarg" = "--confirmed" ] && _has_restore_confirmed=1
            done
            if [ "$_has_restore_confirmed" = "0" ]; then
                if [ "$_in_integration_wt" = "1" ]; then
                    _log_block restore_in_integration_no_confirmed
                    cat >&2 <<'MSG'
WARNING: 'git restore' inside the integration worktree — inspection required.

The integration worktree's index and working tree feed DELIVERY_BOOKKEEPING,
which commits whatever is staged with no path filter. A blind restore here
can land delivery-reverting content on origin/main.

Before proceeding:
  1. Run: git diff HEAD -- <file>   (see what the worktree has)
  2. Verify the working-tree version carries no resolution worth preserving.
  3. Rerun with: git restore --confirmed [--source <ref>] <path>...
MSG
                else
                    _log_block restore_in_merge_no_confirmed
                    cat >&2 <<'MSG'
WARNING: 'git restore' during active merge — inspection required.

This overwrites local versions of conflicted files. In a multi-agent
environment, local main often has hotfixes not present on the remote.

Before proceeding:
  1. Run: git diff HEAD -- <file>   (see what local has)
  2. Run: git diff MERGE_HEAD -- <file>   (see what remote has)
  3. Verify the local version has no unique work worth preserving.
  4. Rerun with: git restore --confirmed [--source <ref>] <path>...
MSG
                fi
                exit 1
            fi
            _restore_args=()
            for _rarg in "$@"; do
                [ "$_rarg" = "--confirmed" ] && continue
                _restore_args+=("$_rarg")
            done
            _real_git "${_restore_args[@]}"
            exit $?
        fi
    fi
fi

# Block 'git add' for agents — staging is owned by telec.
if { [ "$_commit_enabled" -eq 1 ] || [ "$_sealed_invocation_context" -eq 1 ]; } && [ "$_subcmd" = "add" ]; then
    _log_block add_redirect
    cat >&2 <<'MSG'
ERROR: 'git add' is not used by agents. Staging is owned by telec.

For NEW files (untracked), stage them explicitly:
  telec repo add <path> [<path> ...]
  (This is the sealed equivalent of 'git add' for the only case that needs it.)

For EXISTING modified files, no staging is needed at all. Declare what
you're working on and the commit's pathspec takes it straight from the
working tree:
  telec repo add <path> [<path> ...]       # declare what you're working on
  telec repo commit                        # surface commit-first review-routing guidance

NEW files in scope are intentionally NOT auto-committed (catches temp/
scratch artifacts). If you don't `telec repo add` them, they stay
untracked. That's by design.

Inspection tools (git diff, git status, git log) remain available.
MSG
    exit 1
fi

if { [ "$_commit_enabled" -eq 1 ] || [ "$_sealed_invocation_context" -eq 1 ]; } && [ "$_subcmd" = "commit" ]; then
    _log_block commit_redirect
    cat >&2 <<'MSG'
ERROR: Use 'telec repo commit' instead of 'git commit'.

telec repo commit owns staging, scoping, the pathspec commit, and the
mandated trailer.

Start with no flags:
  telec repo commit

That surfaces the commit-first review-routing gate. Commit autonomously
with --approved once the gate is understood, then route any review from the
committed diff. If files outside the resolved scope must be in the commit,
add --include <path> [<path> ...] at re-run time.
MSG
    exit 1
fi

# Block commit-producing replays on main without explicit approval.
# cherry-pick / rebase / merge produce commits via paths whose outer subcmd
# is not 'commit', so the gate above doesn't see them. Without this, replays
# can land on main bypassing telec repo commit's main-branch lock and the
# commit-first review-routing gate.
if [ "$_code_enabled" -eq 1 ] || [ "$_sealed_invocation_context" -eq 1 ]; then
case "$_subcmd" in
    cherry-pick|rebase|merge)
        _produces_commit=1
        for _arg in "$@"; do
            case "$_arg" in
                --abort|--skip|--quit|--no-commit)
                    _produces_commit=0
                    ;;
            esac
        done
        if [ "$_produces_commit" -eq 1 ] && [ "${TELECLAUDE_OVERRIDE_APPROVED:-}" != "1" ]; then
            _current_branch="$(_real_git ${_dir_args[@]+"${_dir_args[@]}"} rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
            if [ "$_current_branch" = "main" ]; then
                if ! _resolve_caller_role; then
                    _log_block caller_role_resolution_failed ERROR
                    echo "ERROR: Could not resolve caller role for git $_subcmd on main." >&2
                    exit 1
                fi
                if [ "$_role" != "integrator" ]; then
                    _log_block "replay_main_unauthorized_${_subcmd}"
                    cat >&2 <<MSG
ERROR: 'git $_subcmd' on main produces commits without going through telec repo commit.

This bypasses telec repo commit's main-branch lock, scope checks, and the
commit-first review-routing gate.

To proceed (explicit override, one-shot):
  TELECLAUDE_OVERRIDE_APPROVED=1 git $_subcmd <args>
MSG
                    exit 1
                fi
            fi
        fi
        ;;
esac
fi

if { [ "$_code_enabled" -eq 1 ] || [ "$_sealed_invocation_context" -eq 1 ]; } && [ "$_subcmd" = "push" ]; then
    _current_branch="$(_real_git ${_dir_args[@]+"${_dir_args[@]}"} rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ "$_current_branch" = "main" ]; then
        if ! _resolve_caller_role; then
            _log_block caller_role_resolution_failed ERROR
            echo "ERROR: Could not resolve caller role for git push from main." >&2
            exit 1
        fi
        if [ "$_role" != "integrator" ]; then
            _log_block push_main_non_integrator
            echo "ERROR: Push from main is a protected operation. Only the integrator role may push from main." >&2
            exit 1
        fi
    fi
fi

_real_git "$@"
