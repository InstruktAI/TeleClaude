#!/usr/bin/env bash
# Git wrapper for TeleClaude agent sessions.
#
# Three-tier permission model:
#   DESTRUCTIVE  — blocked for all roles, no override
#   PROTECTED    — integrator only (stash, commit on main, push on main)
#   RESTRICTED   — orchestrator cannot commit on any branch
#
# Roles (TELECLAUDE_SYSTEM_ROLE, set by daemon bootstrap only):
#   (unset)      — human-interactive session, defaults to worker permissions internally
#   worker       — can commit on worktree branches, blocked on main
#   system       — same as worker (job runners)
#   orchestrator — no commits anywhere (machine commands only)
#   integrator   — full protected access (merge workflow)
#
# When TELECLAUDE_SYSTEM_ROLE is unset (human sessions), the wrapper applies
# worker-equivalent restrictions. The variable is never exported — it stays
# local to this script and does not affect the session environment.
#
# Daemon Python code bypasses this wrapper via teleclaude/git.py.
# Installed via `telec init` into ~/.teleclaude/bin/git.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

_WRAPPER_LOG="${TELECLAUDE_GIT_WRAPPER_LOG:-}"

_log_wrapper() {
    [ -n "$_WRAPPER_LOG" ] && echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] [git-wrapper] role=$_role subcmd=$_subcmd args=$* cwd=$(pwd)" >> "$_WRAPPER_LOG" || true
}

_real_git() {
    IFS=: read -ra path_parts <<< "$PATH"
    for dir in "${path_parts[@]}"; do
        [ "$dir" = "$SCRIPT_DIR" ] && continue
        if [ -x "$dir/git" ]; then
            # Disable all auto-stash for every git invocation through the wrapper.
            # Both rebase and merge can auto-stash dirty files internally.
            # Stash is repo-wide — auto-stash from one worktree corrupts another.
            _count="${GIT_CONFIG_COUNT:-0}"
            export GIT_CONFIG_COUNT=$((_count + 2))
            export "GIT_CONFIG_KEY_${_count}=rebase.autoStash"
            export "GIT_CONFIG_VALUE_${_count}=false"
            export "GIT_CONFIG_KEY_$((_count + 1))=merge.autoStash"
            export "GIT_CONFIG_VALUE_$((_count + 1))=false"
            _log_wrapper "$@"
            "$dir/git" "$@"
            return $?
        fi
    done
    echo "ERROR: real git binary not found in PATH" >&2
    exit 1
}

# Find the actual git subcommand by skipping global flags.
# Also capture -C <dir> so branch checks run in the correct worktree.
_subcmd=""
_skip_next=0
_capture_C=0
_dir_args=()
for _arg in "$@"; do
    if [ "$_capture_C" -eq 1 ]; then
        _dir_args+=("-C" "$_arg")
        _capture_C=0
        _skip_next=0
        continue
    fi
    if [ "$_skip_next" -eq 1 ]; then
        _skip_next=0
        continue
    fi
    case "$_arg" in
        -C)
            _capture_C=1
            _skip_next=1
            ;;
        -c|--git-dir|--work-tree|--namespace)
            _skip_next=1
            ;;
        --git-dir=*|--work-tree=*|--namespace=*|-c*)
            ;;
        --bare|--no-pager|--paginate|--no-replace-objects|--literal-pathspecs|--glob-pathspecs|--no-optional-locks)
            ;;
        -*)
            ;;
        *)
            _subcmd="$_arg"
            break
            ;;
    esac
done

_role="${TELECLAUDE_SYSTEM_ROLE:-worker}"

# ── DESTRUCTIVE: blocked for all roles, no override ──────────────────────────
case "$_subcmd" in
    restore)
        echo "ERROR: 'git restore' is a destructive operation and is prohibited." >&2
        exit 1
        ;;
    clean)
        echo "ERROR: 'git clean' is a destructive operation and is prohibited." >&2
        exit 1
        ;;
    switch)
        echo "ERROR: 'git switch' is a destructive operation and is prohibited." >&2
        exit 1
        ;;
    revert)
        _has_confirmed=0
        for _rarg in "$@"; do
            [ "$_rarg" = "--confirmed" ] && _has_confirmed=1
        done
        if [ "$_has_confirmed" -eq 0 ]; then
            cat >&2 <<'MSG'
WARNING: 'git revert' blocked — inspection required.

Commits in multi-agent environments often contain changes from multiple workers.
A blind revert destroys other agents' work.

Before reverting:
  1. Run: git show --stat <commit>
  2. Verify EVERY file in the commit belongs to the scope you intend to undo.
  3. Rerun with: git revert --confirmed <commit>
MSG
            exit 1
        fi
        # Strip --confirmed before passing to real git
        _revert_args=()
        for _rarg in "$@"; do
            [ "$_rarg" = "--confirmed" ] && continue
            _revert_args+=("$_rarg")
        done
        _real_git "${_revert_args[@]}"
        exit $?
        ;;
esac

# Destructive reset variants (--hard, --merge, --keep) blocked for all roles.
# Pathspec reset (git reset HEAD <file>, git reset -- <file>) is allowed.
if [ "$_subcmd" = "reset" ]; then
    _has_separator=0
    _non_flag_args=0
    
    _is_subcmd=0
    for _arg in "$@"; do
        if [ "$_is_subcmd" -eq 0 ]; then
            [ "$_arg" = "reset" ] && _is_subcmd=1
            continue
        fi
        
        case "$_arg" in
            --hard|--merge|--keep)
                echo "ERROR: 'git reset $_arg' is prohibited in agent sessions. Do not discard commits." >&2
                exit 1
                ;;
            --)
                _has_separator=1
                ;;
            -*)
                ;;
            *)
                _non_flag_args=$((_non_flag_args + 1))
                ;;
        esac
    done

    # Pathspec reset (allowed): git reset [<tree-ish>] [--] <pathspec>...
    # Commit reset (prohibited): git reset [<mode>] [<commit>]
    
    # We allow pathspec resets if they are unambiguous:
    # 1. Contain '--' separator
    # 2. Contain at least 2 non-flag arguments (likely <tree-ish> <pathspec>)
    if [ "$_has_separator" -eq 1 ] && [ "$_non_flag_args" -ge 1 ]; then
        : # allowed — pathspec reset (separator + at least one pathspec arg)
    elif [ "$_non_flag_args" -ge 2 ]; then
        : # allowed — likely 'git reset <tree-ish> <pathspec>...'
    else
        # 0 or 1 non-flag args without '--' is either bare reset or ambiguous 'git reset <commit|path>'.
        # We block these to prevent accidental HEAD movement or full index reset.
        cat >&2 <<'MSG'
ERROR: 'git reset' without explicit pathspecs is prohibited.

To unstage specific files, use:
  git reset HEAD <path>
  git reset -- <path>

Bare 'git reset' or 'git reset <commit>' are blocked because they move HEAD
or discard the entire staging area, which violates safety policy.
MSG
        exit 1
    fi
fi

# ── PROTECTED: integrator only ────────────────────────────────────────────────
if [ "$_subcmd" = "stash" ] && [ "$_role" != "integrator" ]; then
    echo "ERROR: 'git stash' is a protected operation. Only the integrator role may use it." >&2
    exit 1
fi

if [ "$_subcmd" = "checkout" ]; then
    _has_separator=0
    for _carg in "$@"; do
        [ "$_carg" = "--" ] && _has_separator=1
    done
    if [ "$_has_separator" -eq 1 ]; then
        : # allowed — file-scoped checkout is local to the working tree (pre-commit needs this)
    else
        echo "ERROR: 'git checkout' (branch switch) is a protected operation. Only file-scoped checkout (with --) is allowed." >&2
        exit 1
    fi
fi

if [ "$_subcmd" = "commit" ]; then
    _current_branch="$(_real_git "${_dir_args[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ "$_current_branch" = "main" ] && [ "$_role" != "integrator" ]; then
        cat >&2 <<'MSG'
ERROR: Commits on main are a protected operation.

STEP 1 — Inspect:
  git diff --staged --name-only
  git status

STEP 2 — Classify and propose ONE of these paths to the human:

  A) Only non-functional files (Markdown, YAML, todo scaffolding, roadmap,
     state files, doc snippets — no .py / .ts / .sh logic):
     → Ask human to approve, then commit with --no-verify:
       TELECLAUDE_SYSTEM_ROLE=integrator git commit --no-verify -m "chore(...): <subject> [skip ci]"

  B) Functional code change that is small and self-evident (human is present
     and driving this, no meaningful review value):
     → Ask human to approve, then commit with hooks:
       TELECLAUDE_SYSTEM_ROLE=integrator git commit -m "<type>(<scope>): <subject>"

  C) Functional code change of any real substance:
     → Must go through the review pipeline:
       telec todo from-main --slug <meaningful-name>
       telec todo work <slug>

STEP 3 — Ask:
  State which path you recommend and why (file types seen, size, context).
  Then ask: "Shall I proceed with [path X]?"
  Wait for the user to confirm before executing.
MSG
        exit 1
    fi
fi

if [ "$_subcmd" = "push" ]; then
    _current_branch="$(_real_git "${_dir_args[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ "$_current_branch" = "main" ] && [ "$_role" != "integrator" ]; then
        echo "ERROR: Push from main is a protected operation. Only the integrator role may push from main." >&2
        exit 1
    fi
fi

# ── ORCHESTRATOR RESTRICTION: no commit on any branch ────────────────────────
if [ "$_subcmd" = "commit" ] && [ "$_role" = "orchestrator" ]; then
    echo "ERROR: Orchestrators cannot commit. Use telec machine commands (mark-phase, etc.)." >&2
    exit 1
fi

_real_git "$@"
