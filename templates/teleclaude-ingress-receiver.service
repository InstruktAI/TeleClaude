[Unit]
Description=TeleClaude ingress webhook receiver
Requires=teleclaude-ingress-receiver.socket
After=network.target teleclaude-ingress-receiver.socket

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{WORKING_DIR}}
Environment=PATH={{PATH}}
Environment=UV_NO_SYNC=1
Environment=XDG_DATA_HOME={{XDG_DATA_HOME}}
ExecStart={{PYTHON_PATH}} -m teleclaude.hooks.ingress_receiver
# The receiver exits with a failure status when the active release or the machine configuration changes, and
# is started again while the socket stays open; it exits cleanly, and stays stopped, when this computer is no
# longer the ingress.
Restart=on-failure
RestartSec=1
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
