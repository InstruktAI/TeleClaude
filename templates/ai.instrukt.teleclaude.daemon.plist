<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.instrukt.teleclaude.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON_PATH}}</string>
        <string>-m</string>
        <string>teleclaude.daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{WORKING_DIR}}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>.venv/bin:{{PATH}}</string>
        <key>UV_NO_SYNC</key>
        <string>1</string>
        <key>XDG_DATA_HOME</key>
        <string>{{XDG_DATA_HOME}}</string>
    </dict>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
    <key>StandardInPath</key>
    <string>/dev/null</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>AbandonProcessGroup</key>
    <true/>
    <!-- No WatchPaths: the daemon owns config reloads via its in-process ConfigWatcher,
         which hot-reloads live sections and self-restarts (KeepAlive relaunches) only for
         connection-bound changes. A launchd WatchPaths here would blindly restart on every
         config edit, preempting the hot path. -->

    <!-- Forces macOS to keep this process at a high scheduling priority -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- Gives it the highest possible CPU scheduling priority (lower means higher priority) -->
    <key>Nice</key>
    <integer>-20</integer>
    <!-- Prevents macOS from aggressively putting the process into App Nap / efficiency throttling -->
    <key>LowPriorityIO</key>
    <false/>
</dict>
</plist>
