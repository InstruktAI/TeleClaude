[project]
name = "{{project_name}}"
version = "0.1.0"
requires-python = ">=3.12"

[dependency-groups]
dev = [
    "mypy>=1.8.0",
    "pyright>=1.1.0",
    "pytest>=8.0.0",
    "ruff>=0.12.0",
    "syrupy>=4.7.0",
]

[tool.ruff]
line-length = 120
target-version = "py312"
src = ["{{project_name}}", "tools", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "C90", "B", "UP", "RUF"]
ignore = ["E501"]

[tool.ruff.lint.mccabe]
max-complexity = 20

[tool.pyright]
typeCheckingMode = "strict"
pythonVersion = "3.12"

[tool.mypy]
python_version = "3.12"
strict = true

[tool.pytest.ini_options]
testpaths = ["tests"]
