#!/bin/bash
# TeleClaude terminal CLI wrapper.
# Resolvable from any location: follows symlinks back to this file and invokes
# the telec module via `uv run --directory` against the checkout this file
# belongs to, so `uv` manages that checkout's environment from its own
# pyproject.toml. The wrapper's location selects the code that runs, never the
# caller's working directory
# (docs/project/adr/0102-a-telec-wrapper-runs-the-checkout-it-belongs-to.md).
# From a slug worktree, this wrapper refuses to run against the live
# TeleClaude home (docs/project/design/architecture/cli-invocation-boundary.md).
set -euo pipefail

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$DIR/$TARGET"
  fi
done

INSTALL_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# Preserve the user's invocation directory. `uv run --directory` below sets the
# Python process cwd to INSTALL_DIR, which breaks worktree-scope detection in
# telec code lint/test (`Path.cwd()` would point at the checkout, not the
# directory the user invoked from). Handlers read this env var to resolve the
# real cwd.
export TELEC_INVOCATION_CWD="$PWD"
# Block `uv run`'s implicit venv sync. Ambient sync while TeleClaude's daemon
# holds modules loaded causes stale-module ImportError crashes. Explicit
# `uv sync` (install.sh, dependency_upgrade job) still works.
export UV_NO_SYNC=1

LIVE_TELECLAUDE_HOME="$HOME/.teleclaude"

_telec_refuse_live_home() {
  printf 'ERROR: %s refuses to run against the live TeleClaude home.\n' "$SOURCE" >&2
  printf 'Set TELECLAUDE_HOME to a scratch location instead, for example:\n' >&2
  # shellcheck disable=SC2016 # literal example text: $(mktemp -d) is shown unexpanded for the reader to type
  printf '  TELECLAUDE_HOME="$(mktemp -d)" %s <args...>\n' "$SOURCE" >&2
  exit 1
}

INSTALL_PARENT_NAME="$(basename "$(dirname "$INSTALL_DIR")")"
INSTALL_DIR_NAME="$(basename "$INSTALL_DIR")"

if [ "$INSTALL_PARENT_NAME" = "trees" ] && [ "$INSTALL_DIR_NAME" != "_integration" ]; then
  # This wrapper belongs to a slug worktree. Its code never runs against the
  # live home: an unset, empty, or live-home-identical TELECLAUDE_HOME is
  # refused before any worktree code runs.
  if [ -z "${TELECLAUDE_HOME:-}" ]; then
    _telec_refuse_live_home
  fi

  # Match the literal, unexpanded "~/..." spelling a caller can pass inside a
  # quoted assignment (TELECLAUDE_HOME="~/.teleclaude"); the shell never
  # expands it in that position, so this wrapper expands it itself.
  CANDIDATE_HOME="$TELECLAUDE_HOME"
  # shellcheck disable=SC2088 # intentional: matching the literal unexpanded tilde spelling, not expanding one
  case "$CANDIDATE_HOME" in
  "~")
    CANDIDATE_HOME="$HOME"
    ;;
  "~/"*)
    CANDIDATE_HOME="$HOME/${CANDIDATE_HOME#"~/"}"
    ;;
  esac
  case "$CANDIDATE_HOME" in
  /*)
    ;;
  *)
    CANDIDATE_HOME="$PWD/$CANDIDATE_HOME"
    ;;
  esac

  if [ -e "$CANDIDATE_HOME" ] && [ "$CANDIDATE_HOME" -ef "$LIVE_TELECLAUDE_HOME" ]; then
    _telec_refuse_live_home
  fi

  export TELECLAUDE_HOME="$CANDIDATE_HOME"
  mkdir -p "$TELECLAUDE_HOME"
  if [ ! -f "$TELECLAUDE_HOME/config.yml" ]; then
    cp -p "$LIVE_TELECLAUDE_HOME/config.yml" "$TELECLAUDE_HOME/config.yml"
  fi
fi

exec uv run --directory "$INSTALL_DIR" --quiet python -m teleclaude.cli.telec "$@"
