# v2 Rust workspace local-dev environment.
# Copy to .env (or source it) for local development.

# Postgres (workflow + future v2 services).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teleclaude

# Redis (event bus + cache).
REDIS_URL=redis://localhost:6379

# Identity (single-user MVP stub).
TELECLAUDE_OWNER_EMAIL=you@example.com

# Observability — overrides /var/log/instrukt-ai/teleclaude when set.
# INSTRUKT_AI_LOG_DIR=/tmp/instrukt-ai/teleclaude

# Logging level filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info
