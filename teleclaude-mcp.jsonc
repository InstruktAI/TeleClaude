{
  "$schema": "./schemas/teleclaude-mcp.schema.json",
  "servers": {
    "context7": {
      "trigger": "Use to read easily ingestible technical third-party documentation.",
      "command": "npx",
      "args": [ "-y", "@upstash/context7-mcp" ]
    },
    "excalidraw": {
      "trigger": "Use for agent-readable collaborative architecture drawing, diagramming, and visual refinement. Use only through `software-development/procedure/collaborative-architecture-canvas`, which governs collaboration, persistence, and server lifecycle.",
      "command": "npx",
      "args": [ "-y", "mcp-excalidraw-server@1.1.0" ]
    },
    "firecrawl": {
      "trigger": "Use to crawl SPAs and other hard-to-read pages not readable with web search. Call `telec docs get general/procedure/firecrawl-web-scraping` first.",
      "command": "npx",
      "args": [ "-y", "firecrawl-mcp" ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "omi-memory": {
      "trigger": "Use to retrieve memories created on the go with the third-party Omi service. Use when the word omi appears or STT may have translated it as \"oh me\".",
      "transport": "http",
      "url": "https://api.omi.me/v1/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${OMI_API_KEY}"
      }
    },
    "playwright": {
      "trigger": "Use when frontend look-and-feel checks or other browser-related checks are needed. Not the same as browser-use, which is a native function of the agent CLI to surf on the user's behalf. For ad-hoc Playwright scripting outside this server: never `npx playwright` or `playwright install` — use a pinned project install (e.g. `pnpm exec playwright` in frontend/) or Python playwright with channel=\"chrome\" so the system Chrome is reused.",
      "command": "npx",
      "args": [ "-y", "@playwright/mcp@latest", "--browser", "chrome" ]
    }
  }
}
