# TeleClaude runtime DB artifacts (now live under ~/.teleclaude/)
# Kept for safety in case of accidental local creation
teleclaude.db
teleclaude.db-wal
teleclaude.db-shm

AGENTS.md
CLAUDE.md

# TeleClaude worktree infrastructure state (changes with every prep cycle)
.teleclaude/*
!.teleclaude/

# Generated build artifacts (never tracked)
**/index.yaml
bin/*.app/
# Per-domain baseline bundle: regenerated into the owning publisher's source
# dir each sync, resolved through the deployed per-domain symlink.
docs/global/*/domain-baseline-bundle.md

# Blueprint engine working directory (graphify cache/output; the published
# Blueprint lives under .teleclaude/blueprint/). Never tracked.
graphify-out/

# Rust (v2 workspace) — target/ is build output, never tracked.
# Cargo.lock IS tracked at workspace root (binary workspace policy).
target/
*.rs.bk
**/*.rs.bk

# Local AI config artifacts
.antigravitycli/
.claude/
.codex/
.gemini/

# Temporary backup / scratch dirs
.temp/
.teleclaude*copy/
scratch_*.txt

# Helpdesk generated files (should NEVER happen but must never be tracked)
helpdesk/
!helpdesk/AGENTS.master.md

# Ephemeral content dumps (telec content dump); keep folder structure only
publications/inbox/*
!publications/inbox/.gitkeep
scratchpad/
