# TeleClaude Configuration
WORKING_DIR=~/Workspace
TELECLAUDE_LOG_LEVEL=INFO

# Redis Configuration (for AI-to-AI communication)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Anthropic API Key (for summarization fallback)
ANTHROPIC_API_KEY=

# OpenAI API Key (for summarization fallback, and voice transcription fallback via Whisper)
OPENAI_API_KEY=

# Google API key (for summarization fallback, Nano Banana)
GOOGLE_API_KEY=

# Discord admin environment
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_USERNAME=

# Postgres Configuration (for v2 services)
# TODO: re-enable at v2 workflow cutover; unused by v1.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/teleclaude

# Email and SMTP Configuration (for email invitations/notifications)
EMAIL_FROM=
EMAIL_REPLYTO=
SMTP_KEY=
SMTP_RELAY=
SMTP_USERNAME=

# Scraping: FireCrawl
FIRECRAWL_API_KEY=

# S3 backup target
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_HOST=
AWS_S3_REGION=
AWS_S3_BUCKET=
TELECLAUDE_BACKUP_PREFIX=teleclaude/comp1

# Local Summarizer LLM API URL
SUMMARIZER_LLM_BASE_URL=http://localhost:1234/v1
SUMMARIZER_LLM_MODEL=qwen3.5-0.8b

