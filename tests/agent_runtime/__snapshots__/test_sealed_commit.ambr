# name: test_slug_worktree_refuses_doc_layer_paths
  dict({
    'stderr': '''
      ERROR: doc-layer paths cannot be committed from a slug worktree:
        docs/feature.md
      
      The doc layer is authored at prepare on main and folded at integration; the work phase executes a frozen contract. If a doc need surfaced mid-build, kick back instead of editing docs/** here:
        telec todo stamp <slug> --kickback --reason "<why the plan cannot be built>"
  
    ''',
  })
