# serializer version: 1
# name: test_discord_admin_reflection_preserves_user_attribution_for_text_input
  dict({
    'bot_send_count': 0,
    'message_id': 'webhook-1',
    'webhook_sends': list([
      dict({
        'avatar_url': 'https://example.test/avatar.png',
        'content': 'hello from user',
        'username': 'Morriz',
        'wait': True,
      }),
    ]),
  })
# ---
# name: test_discord_non_reflection_output_still_uses_normal_send
  dict({
    'bot_sends': list([
      'hello from agent',
    ]),
    'message_id': 'bot-1',
  })
# ---
# name: test_discord_user_transcription_displays_use_user_attribution_or_do_not_render
  dict({
    'deleted_messages': list([
      'notice-actor',
      'notice-anonymous',
    ]),
    'sent_messages': list([
      dict({
        'message': 'resolved transcription',
        'reflection_actor_avatar_url': 'https://example.test/avatar.png',
        'reflection_actor_name': 'Morriz',
        'reflection_origin': 'discord',
      }),
      dict({
        'message': 'anonymous transcription',
        'reflection_actor_avatar_url': None,
        'reflection_actor_name': 'Morriz',
        'reflection_origin': 'discord',
      }),
    ]),
  })
# ---
