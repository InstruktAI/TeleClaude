# name: test_discord_user_transcription_displays_use_user_attribution_or_do_not_render
  dict({
    'deleted_messages': list([
      'notice-actor',
      'notice-anonymous',
    ]),
    'route_bot_send_count': 0,
    'route_webhook_sends': list([
      dict({
        'avatar_url': 'https://example.test/avatar.png',
        'content': 'resolved transcription',
        'username': 'Morriz',
        'wait': True,
      }),
      dict({
        'content': 'anonymous transcription',
        'username': 'Morriz',
        'wait': True,
      }),
    ]),
    'routed_message_ids': list([
      'webhook-1',
      'webhook-2',
    ]),
    'sent_messages': list([
      dict({
        'message': 'resolved transcription',
        'reflection_actor_avatar_url': 'https://example.test/avatar.png',
        'reflection_actor_name': 'Morriz',
        'reflection_origin': 'discord',
      }),
      dict({
        'message': 'anonymous transcription',
        'reflection_actor_avatar_url': None,
        'reflection_actor_name': 'Morriz',
        'reflection_origin': 'discord',
      }),
    ]),
  })
