# serializer version: 1
# name: TestHandleCodeCommitContract.test_bare_call_on_main_prints_abc_classification
  '''
  Commit gate on main.
  
  Check scope first:
    telec code changed
  
  New files require explicit inclusion:
    telec code add <path> [<path> ...]
    telec code commit --approved '<msg>' --include <path>
  
  Foreign staged files are excluded by pathspec. Do not unstage them.
  
  A) Docs/config/state only:
     Commit with --approved. Review is not required.
  
  B) Small functional change:
     Commit with --approved.
  
  C) Functional change needing review:
     Commit with --approved.
  
  Review gate for B/C:
     After committing B or C, you must ask the human whether to send the commit(s) to review.
     Include your recommendation. For C, recommend review.
     If review is approved and a reviewer is already open for this patch series, reuse it:
       telec sessions send <reviewer-session-id> 'review commits <sha1,sha2,...>'
     If no reviewer is open, start one:
       telec sessions run --command /next-review-commits --args '<sha1,sha2,...>' --agent <agent>
     Wait for REVIEW COMPLETE before reporting done.
  
  '''
# ---
