# serializer version: 1
# name: test_usage_leaf_sessions_run_renders_full_output
  '''
  Usage:
    telec sessions run [--command <cmd>] [--project <path>] [--args <val>] [--agent <name>] [--mode <mode>] [--computer <host>] [--subfolder <dir>] [--additional-context <ctx>]
  
    Run a slash command on a new agent session
  
  Options:
    --command              Slash command (e.g. /next-build)
    --project              Project directory path (optional; defaults to cwd)
    --args                 Command arguments
    --agent                Agent: claude, gemini, codex
    --mode                 Thinking mode: fast, med, slow
    -c, --computer         Target computer (optional; defaults to local)
    --subfolder            Subdirectory within the project
    --additional-context   Additional context for the worker, appended to startup message
  
  Notes:
    Creates a fresh session and runs the slash command as the first agent message.
    Worker lifecycle commands: /next-build, /next-review-build, /next-fix-review, /next-finalize.
    --detach: do not use unless explicitly instructed. Sanctioned only for a personal-assistant dispatching an orchestrator to a project. --detach disables notifications — you will not learn when the child finishes, so omit it whenever your next step depends on the result.
  
  Examples:
    telec sessions run --command /next-build --args my-slug
  
  '''
# ---
# name: test_usage_main_sessions_overview_renders_without_hidden_flags
  '''
    telec sessions start [--computer <host>] [--project <path>] [--agent <name>] [--mode <mode>] [--message <msg>] [--direct] [--computer --project --agent --mode --message --direct]# Start a new agent session
    telec sessions run [--command <cmd>] [--project <path>] [--args <val>] [--agent <name>] [--mode <mode>] [--computer <host>] [--subfolder <dir>] [--additional-context <ctx>] [--command --project --args --agent --mode --computer --subfolder --additional-context]# Run a slash command on a new agent session
  '''
# ---
