# serializer version: 1
# name: test_build_attach_cmd_includes_ssh_and_appearance_env_for_remote_sessions
  "ssh -t -A alice@example.test 'APPEARANCE_MODE=dark TERMINAL_BG=#000000 TERM=tmux-256color tmux -u set -sa terminal-overrides ',tmux-256color:Tc' \\; set -sa terminal-features 'tmux-256color:RGB' \\; set-option -t tc_demo status off \\; attach-session -t tc_demo'"
# ---
# name: test_build_attach_cmd_uses_local_tmux_binary_when_session_is_local
  "env -u TMUX TERM=tmux-256color tmux-bin -u set -sa terminal-overrides ',tmux-256color:Tc' \\; set -sa terminal-features 'tmux-256color:RGB' \\; set-option -t tc_demo status off \\; attach-session -t tc_demo"
# ---
