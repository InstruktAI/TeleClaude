# serializer version: 1
# name: test_generated_python_project_make_install_lint_and_test_smoke_without_network
  dict({
    'hook_contains_install_python': False,
    'uv_invocations': list([
      'run --group dev python -c print("Python environment ready")',
      'run ruff check .',
      'run ruff format --check .',
      'run pyright',
      'run mypy',
      'run pytest',
    ]),
  })
