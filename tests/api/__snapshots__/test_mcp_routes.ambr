# name: test_route_translates_runtime_errors_without_secret_values
  dict({
    'invalid_arguments': dict({
      'body': dict({
        'detail': 'MCP tool arguments must be a JSON object',
      }),
      'status': 400,
    }),
    'missing_env': dict({
      'body': dict({
        'detail': dict({
          'code': 'missing_env',
          'message': 'MCP server is missing required environment values',
          'missingEnv': list([
            'SECRET_TOKEN',
          ]),
          'server': 'needs-env',
        }),
      }),
      'status': 503,
    }),
    'unknown': dict({
      'body': dict({
        'detail': dict({
          'code': 'unknown_server',
          'message': 'Unknown MCP server: missing',
          'server': 'missing',
        }),
      }),
      'status': 404,
    }),
  })
