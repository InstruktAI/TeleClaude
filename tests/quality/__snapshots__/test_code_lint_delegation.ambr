# serializer version: 1
# name: test_lint_passes_adversarial_paths_through_nul_files_from
  dict({
    'records': list([
      dict({
        'cmd': list([
          'make',
          'lint',
        ]),
        'cwd': '<project-root>',
        'files': list([
          b'a b.py',
          b'c;d.py',
        ]),
      }),
      dict({
        'guardrails_files': list([
          'a b.py',
          'c;d.py',
        ]),
        'guardrails_project_matches': True,
        'guardrails_project_root': '<project-root>',
        'guardrails_run_all': False,
      }),
    ]),
  })
# ---
# name: test_lint_propagates_make_failure_after_guardrails_run
  dict({
    'records': list([
      tuple(
        'make',
        list([
          'make',
          'lint',
        ]),
        '<project-root>',
        list([
          b'teleclaude/core.py',
        ]),
      ),
      tuple(
        'guardrails',
        '<project-root>',
        True,
        list([
          'teleclaude/core.py',
        ]),
        False,
      ),
    ]),
  })
