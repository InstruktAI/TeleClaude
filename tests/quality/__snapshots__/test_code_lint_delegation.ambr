# name: test_rust_scope_uses_package_when_changed_path_belongs_to_one_crate
  dict({
    'kind': <RustScopeKind.PACKAGE: 'package'>,
    'package': 'telec-core',
    'rust_owned_paths': tuple(
      'crates/telec-core/src/lib.rs',
    ),
    'workspace_root': True,
  })
# ---
# name: test_rust_scope_uses_workspace_when_root_cargo_manifest_changes
  dict({
    'is_workspace': True,
    'kind': <RustScopeKind.WORKSPACE: 'workspace'>,
    'package': None,
    'rust_owned_paths': tuple(
      'Cargo.toml',
    ),
    'workspace_root': True,
  })
