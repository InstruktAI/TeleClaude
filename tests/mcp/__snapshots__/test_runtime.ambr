# ---
# name: test_serialized_calls_keep_responses_isolated[log]
  list([
    'alpha:start',
    'alpha:initialized',
    'alpha:call:first',
    'alpha:call:second',
  ])
# ---
# name: test_serialized_calls_keep_responses_isolated[results]
  list([
    dict({
      'result': dict({
        'content': list([
          dict({
            'text': 'alpha',
            'type': 'text',
          }),
        ]),
        'isError': False,
      }),
      'server': 'alpha',
      'tool': 'first',
    }),
    dict({
      'result': dict({
        'content': list([
          dict({
            'text': 'alpha',
            'type': 'text',
          }),
        ]),
        'isError': False,
      }),
      'server': 'alpha',
      'tool': 'second',
    }),
  ])
# ---
# name: test_tool_failure_does_not_poison_later_queued_call
  dict({
    'error': dict({
      'code': 'tool_call_failed',
      'message': 'MCP tool call failed',
      'server': 'alpha',
    }),
    'later': dict({
      'result': dict({
        'content': list([
          dict({
            'text': 'alpha',
            'type': 'text',
          }),
        ]),
        'isError': False,
      }),
      'server': 'alpha',
      'tool': 'later',
    }),
    'log': list([
      'alpha:start',
      'alpha:initialized',
      'alpha:call:fail',
      'alpha:call:later',
    ]),
  })
# ---
