# serializer version: 1
# name: test_call_tool_reuses_warm_lease[log]
  list([
    'alpha:start',
    'alpha:initialized',
    'alpha:list-tools',
    'alpha:call:alpha-tool',
  ])
# ---
# name: test_call_tool_reuses_warm_lease[result]
  dict({
    'result': dict({
      'content': list([
        dict({
          'text': 'alpha',
          'type': 'text',
        }),
      ]),
      'isError': False,
    }),
    'server': 'alpha',
    'tool': 'alpha-tool',
  })
# ---
# name: test_cancelled_waiting_call_does_not_poison_later_call
  dict({
    'later': dict({
      'result': dict({
        'content': list([
          dict({
            'text': 'alpha',
            'type': 'text',
          }),
        ]),
        'isError': False,
      }),
      'server': 'alpha',
      'tool': 'later',
    }),
    'log': list([
      'alpha:start',
      'alpha:initialized',
      'alpha:call:first',
      'alpha:call:later',
    ]),
  })
# ---
# name: test_child_process_receives_only_server_env_and_process_basics
  list([
    'alpha:start',
    'alpha:initialized',
    'alpha:list-tools',
  ])
# ---
# name: test_env_drift_restarts_warm_lease_with_new_fingerprint
  list([
    'alpha:start',
    'alpha:initialized',
    'alpha:list-tools',
    'alpha:shutdown',
    'alpha:exit',
    'alpha:start',
    'alpha:initialized',
    'alpha:list-tools',
  ])
# ---
# name: test_idle_reaper_closes_expired_lease
  list([
    'alpha:start',
    'alpha:initialized',
    'alpha:list-tools',
    'alpha:shutdown',
    'alpha:exit',
  ])
# ---
