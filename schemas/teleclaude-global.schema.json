{
  "$defs": {
    "AutonomyLevel": {
      "description": "Execution autonomy levels for domain cartridges.",
      "enum": ["manual", "notify", "auto_notify", "autonomous"],
      "title": "AutonomyLevel",
      "type": "string"
    },
    "AutonomyMatrix": {
      "additionalProperties": true,
      "description": "Priority-ordered autonomy overrides for domains, cartridges, and events.",
      "properties": {
        "global_default": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "notify"
        },
        "by_domain": {
          "additionalProperties": {
            "$ref": "#/$defs/AutonomyLevel"
          },
          "title": "By Domain",
          "type": "object"
        },
        "by_cartridge": {
          "additionalProperties": {
            "$ref": "#/$defs/AutonomyLevel"
          },
          "title": "By Cartridge",
          "type": "object"
        },
        "by_event_type": {
          "additionalProperties": {
            "$ref": "#/$defs/AutonomyLevel"
          },
          "title": "By Event Type",
          "type": "object"
        }
      },
      "title": "AutonomyMatrix",
      "type": "object"
    },
    "DomainConfig": {
      "additionalProperties": true,
      "description": "Configuration for a single domain-specific event pipeline.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "guardian": {
          "$ref": "#/$defs/DomainGuardianConfig"
        },
        "autonomy": {
          "$ref": "#/$defs/AutonomyMatrix"
        }
      },
      "required": ["name"],
      "title": "DomainConfig",
      "type": "object"
    },
    "DomainGuardianConfig": {
      "additionalProperties": true,
      "description": "Guardian agent settings used when a domain requires evaluation.",
      "properties": {
        "agent": {
          "default": "claude",
          "title": "Agent",
          "type": "string"
        },
        "mode": {
          "default": "med",
          "title": "Mode",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "evaluation_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Prompt"
        }
      },
      "title": "DomainGuardianConfig",
      "type": "object"
    },
    "DomainsConfig": {
      "additionalProperties": true,
      "description": "Top-level configuration for repo-owned domain event pipelines.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "domains": {
          "additionalProperties": {
            "$ref": "#/$defs/DomainConfig"
          },
          "title": "Domains",
          "type": "object"
        }
      },
      "title": "DomainsConfig",
      "type": "object"
    },
    "JobSubscription": {
      "additionalProperties": true,
      "description": "Job-triggered subscription.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "notification": {
          "$ref": "#/$defs/SubscriptionNotification",
          "default": {
            "preferred_channel": "telegram",
            "email": null
          }
        },
        "type": {
          "const": "job",
          "default": "job",
          "title": "Type",
          "type": "string"
        },
        "job": {
          "title": "Job",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobWhenConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["job"],
      "title": "JobSubscription",
      "type": "object"
    },
    "JobWhenConfig": {
      "additionalProperties": true,
      "description": "Job scheduling time configuration.",
      "properties": {
        "every": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Every"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "weekdays": {
          "default": [],
          "items": {
            "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
            "type": "string"
          },
          "title": "Weekdays",
          "type": "array"
        }
      },
      "title": "JobWhenConfig",
      "type": "object"
    },
    "PersonEntry": {
      "additionalProperties": true,
      "description": "Person identity and role configuration.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "email": {
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "slug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        },
        "role": {
          "default": "member",
          "enum": ["admin", "member", "contributor", "newcomer"],
          "title": "Role",
          "type": "string"
        },
        "preferences": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferences"
        },
        "expertise": {
          "anyOf": [
            {
              "additionalProperties": {
                "enum": ["novice", "intermediate", "advanced", "expert"],
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expertise"
        }
      },
      "required": ["name", "email"],
      "title": "PersonEntry",
      "type": "object"
    },
    "SubscriptionNotification": {
      "additionalProperties": true,
      "description": "Notification channel preference for a subscription.",
      "properties": {
        "preferred_channel": {
          "default": "telegram",
          "enum": ["telegram", "discord", "whatsapp", "email"],
          "title": "Preferred Channel",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        }
      },
      "title": "SubscriptionNotification",
      "type": "object"
    },
    "YoutubeSubscription": {
      "additionalProperties": true,
      "description": "YouTube channel subscription.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "notification": {
          "$ref": "#/$defs/SubscriptionNotification",
          "default": {
            "preferred_channel": "telegram",
            "email": null
          }
        },
        "type": {
          "const": "youtube",
          "default": "youtube",
          "title": "Type",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": ["source"],
      "title": "YoutubeSubscription",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Global-level configuration: the cross-project overlay (people, interests, overlay roots).\n\nLike ``ProjectConfig``, this is an overlay, not the machine runtime config; the\npublic/editable machine surface is the per-field ``tier`` markers on\n``TeleclaudeConfig`` (``project/policy/config-public-surface``). ``checkout_root``\nis the surviving git overlay key, marked ``internal`` \u2014 not human-edited in the\nwizard.",
  "properties": {
    "kind": {
      "const": "global",
      "tier": "internal",
      "title": "Kind",
      "type": "string"
    },
    "env_allow_list": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Env Allow List",
      "type": "array"
    },
    "people": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PersonEntry"
      },
      "title": "People",
      "type": "array"
    },
    "subscriptions": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "job": "#/$defs/JobSubscription",
            "youtube": "#/$defs/YoutubeSubscription"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/JobSubscription"
          },
          {
            "$ref": "#/$defs/YoutubeSubscription"
          }
        ]
      },
      "title": "Subscriptions",
      "type": "array"
    },
    "interests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Interests",
      "type": "array"
    },
    "event_domains": {
      "anyOf": [
        {
          "$ref": "#/$defs/DomainsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "checkout_root": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "tier": "internal",
      "title": "Checkout Root"
    }
  },
  "required": ["kind"],
  "title": "GlobalConfig",
  "type": "object"
}
